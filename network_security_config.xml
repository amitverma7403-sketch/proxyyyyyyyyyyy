<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, and only certificates the system trusts. No user-installed CAs, so a proxy tool
         on the phone cannot read the pairing token. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
